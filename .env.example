# Copy to .env and fill in. Never commit .env. Every key is optional:
# without keys the station runs fully offline (template hosts, rule gate, synthetic voices).
ANTHROPIC_API_KEY=        # Claude: host lines, planning, gate flagging, tone fallback
ELEVENLABS_API_KEY=       # streaming TTS (voice ids live in config/personas/*.yaml)
DEEPGRAM_API_KEY=         # streaming STT for phone calls
TWILIO_AUTH_TOKEN=        # validates Twilio webhook signatures
PUBLIC_URL=               # e.g. https://deadair.example.com (needed for Twilio)
NEWSAPI_KEY=              # optional extra news source
ADMIN_PASSWORD=           # required to open /admin
DEADAIR_DB=data/deadair.db
DEADAIR_STORE_CALL_AUDIO= # set to 1 to keep caller audio in archived recordings (off by default)
DEADAIR_LOG_JSON=          # set to 1 for one JSON object per log line
DEADAIR_TRUST_PROXY=       # set to 1 behind a reverse proxy so rate limits use X-Forwarded-For
